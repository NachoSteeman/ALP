empleados productoNatural salarios

empleados productoNatural departamentos

(empleados productoNatural salarios) productoNatural departamentos






empleados productoNatural salarios



empleados productoNatural departamentos




seleccion [salario > 1500]
(
    empleados productoNatural salarios
)




proyeccion [nombre]
(
    seleccion [salario > 1500]
    (
        empleados productoNatural salarios
    )
)





proyeccion [nombre,nombreDept]
(
    empleados productoNatural departamentos
)




empleados productoNatural trabaja





seleccion [proyecto = "Web"]
(
    empleados productoNatural trabaja
)





seleccion [salario > 1500]
(
    (empleados productoNatural salarios)
    productoNatural
    trabaja
)





renombre [nombre -> nombreEmpleado] (empleados)

renombre [salario -> sueldo] (salarios)





