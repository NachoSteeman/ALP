// Personas;
// Trabajos;
// Empresas;

:createRel Personas nombre:string, edad:int, ciudad:string;
:insertRel Personas (Juan, 25, Rosario), (Ana, 40, SantaFe);

:createRel Trabajos nombre:string, salario:int;
:insertRel Trabajos (Juan, 120000), (Ana, 90000);

:createRel Empresas nombre:string, rubro:string;
:insertRel Empresas (Juan, IT), (Ana, Finance);


Adultos = seleccion[edad > 18](Personas);
Mayores = seleccion[edad > 65](Personas);
Jovenes = seleccion[edad < 30](Personas);

PersonasRosario = seleccion[ciudad = "Rosario"](Personas);
PersonasSantaFe = seleccion[ciudad = "SantaFe"](Personas);

AdultosRosario = Adultos productoNatural PersonasRosario;
AdultosSantaFe = Adultos productoNatural PersonasSantaFe;

Trabajadores = Personas productoNatural Trabajos;
TrabajadoresEmpresas = Trabajadores productoNatural Empresas;

AltosIngresos = seleccion[salario > 100000](TrabajadoresEmpresas);
BajosIngresos = seleccion[salario < 50000](TrabajadoresEmpresas);

NombresAdultos = proyeccion[nombre](Adultos);
NombresMayores = proyeccion[nombre](Mayores);

UnionTest = NombresAdultos union NombresMayores;
DiffTest = NombresAdultos diferencia NombresMayores;
InterTest = NombresAdultos interseccion NombresMayores;

ProdTest = Personas producto Empresas;

JoinComplejo = (Personas productoNatural Trabajos) productoNatural Empresas;

SeleccionCompleja = seleccion[edad > 25 and salario > 80000](JoinComplejo);

ProyCompleja = proyeccion[nombre, ciudad](SeleccionCompleja);

RenombreTest = renombre[nombre -> persona](Personas);

Nested1 = proyeccion[nombre](seleccion[edad > 30](Personas));
Nested2 = seleccion[edad > 30](proyeccion[nombre, edad](Personas));

Nested3 = proyeccion[nombre](seleccion[edad > 30 and ciudad = "Rosario"](Personas));

Nested4 = seleccion[not (edad < 18)](Personas);

Nested5 = seleccion[(edad > 20 and ciudad = "Rosario") or (edad > 30 and ciudad = "SantaFe")](Personas);

Chain1 = proyeccion[nombre](seleccion[edad > 25](Personas productoNatural Trabajos));

Chain2 = proyeccion[nombre](seleccion[salario > 90000](Personas productoNatural Trabajos productoNatural Empresas));

Chain3 = seleccion[salario > 70000](Personas productoNatural Trabajos) diferencia seleccion[salario > 90000](Personas productoNatural Trabajos);

Chain4 = (Personas productoNatural Trabajos) interseccion (Personas productoNatural Empresas);

Chain5 = (Personas producto Empresas) diferencia (Personas productoNatural Empresas);

DivisionTest = Trabajadores division Empresas;

Mega1 = proyeccion[nombre](seleccion[edad > 30](Personas productoNatural Trabajos productoNatural Empresas));

Mega2 = seleccion[salario > 80000](proyeccion[nombre, salario](Personas productoNatural Trabajos));

Mega3 = renombre[nombre -> empleado](proyeccion[nombre](seleccion[salario > 60000](Trabajadores)));

Mega4 = (proyeccion[nombre](Personas) union proyeccion[nombre](Trabajadores)) diferencia proyeccion[nombre](Mayores);

Mega5 = seleccion[not (salario < 50000)](Personas productoNatural Trabajos);

Final1 = proyeccion[nombre](Mega1);
Final2 = proyeccion[nombre](Mega2);
Final3 = Final1 union Final2;
Final4 = Final3 diferencia NombresMayores;
Final5 = Final4 interseccion NombresAdultos;

Final5;




:defineOP DifSimetrica(R, S) (R union S) diferencia (R interseccion S);
:defineOP SoloNombres(Relacion) proyeccion[nombre, salario](Relacion);

